@page "/order-success/{OrderId:int}"
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="my-8">
    <MudCard>
        <MudCardContent Class="text-center">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="mt-3">Заказ #@OrderId успешно оформлен и оплачен!</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">Спасибо за заказ. Наш оператор свяжется с вами для подтверждения.</MudText>
            <Component />
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter] public int OrderId { get; set; }
}