@page "/menu/deserts"
@using BlazorPizzeria.Models
@using BlazorPizzeria.Services
@inject IDessertRepository DessertRepo
@inject CartService Cart
@inject ISnackbar Snackbar

<h3>🍰 Десерты</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <input type="text" class="form-control" placeholder="Поиск по названию или описанию" @bind="_searchTerm" @bind:event="oninput" />
    </div>
</div>

@if (desserts == null)
{
    <p>Загрузка...</p>
}
else if (!desserts.Any())
{
    <div class="alert alert-info">Десерты не найдены.</div>
}
else
{
    var displayed = string.IsNullOrWhiteSpace(_searchTerm) ? desserts : desserts.Where(d => d.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) || d.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
    <div class="row">
        @foreach (var dessert in displayed)
        {
            var localQty = GetLocalQuantity(dessert.Id);
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(dessert.ImageUrl))
                    {
                        <img src="@dessert.ImageUrl" class="card-img-top" alt="@dessert.Name" style="height: 150px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@dessert.Name</h5>
                        <p class="card-text">@dessert.Description</p>
                        <p class="card-text"><strong>@dessert.Price ₽</strong></p>
                        <div class="d-flex align-items-center justify-content-between mt-3">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => DecrementLocalQuantity(dessert.Id)">–</button>
                            <span class="mx-2">@localQty</span>
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => IncrementLocalQuantity(dessert.Id)">+</button>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-primary w-100" @onclick="() => AddToCart(dessert, localQty)">В корзину</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Dessert> desserts = new();
    private string _searchTerm = "";
    private Dictionary<int, int> localQuantities = new();

    private int GetLocalQuantity(int id) => localQuantities.GetValueOrDefault(id, 1);
    private void IncrementLocalQuantity(int id) => localQuantities[id] = Math.Min(GetLocalQuantity(id) + 1, 99);
    private void DecrementLocalQuantity(int id)
    {
        var current = GetLocalQuantity(id);
        if (current > 1) localQuantities[id] = current - 1;
    }

    protected override async Task OnInitializedAsync()
    {
        desserts = await DessertRepo.GetAllAsync();
        foreach (var dessert in desserts) localQuantities.TryAdd(dessert.Id, 1);
        StateHasChanged();
    }

    private void AddToCart(Dessert dessert, int quantity)
    {
        if (quantity <= 0) return;
        Cart.AddItem("Dessert", dessert.Id, dessert.Name, dessert.Price, quantity);
        Snackbar.Add($"{dessert.Name} добавлен в корзину (x{quantity})", Severity.Success);
        localQuantities[dessert.Id] = 1;
    }
}