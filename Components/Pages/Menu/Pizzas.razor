@page "/menu/pizzas"
@using BlazorPizzeria.Models
@using BlazorPizzeria.Services
@inject IPizzaRepository PizzaRepo
@inject CartService Cart
@inject ISnackbar Snackbar

<div class="container my-4">
    <h3>🍕 Пицца</h3>

    <div class="row mb-3">
        <div class="col-md-8">
            <input type="text" class="form-control" @bind="_searchTerm" @bind:event="oninput" placeholder="Поиск по названию или описанию" />
        </div>
        <div class="col-md-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="vegCheckbox" @bind="_onlyVegetarian" />
                <label class="form-check-label" for="vegCheckbox">Только вегетарианские</label>
            </div>
        </div>
    </div>

    @if (pizzas == null)
    {
        <div class="text-center">Загрузка...</div>
    }
    else
    {
        var displayed = GetFilteredPizzas();
        if (!displayed.Any())
        {
            <div class="alert alert-info">Пиццы не найдены. Попробуйте изменить фильтры.</div>
        }
        else
        {
            <div class="row">
                @foreach (var pizza in displayed)
                {
                    <div class="col-md-3 mb-3">
                        <div class="card h-100">
                            @if (!string.IsNullOrEmpty(pizza.ImageUrl))
                            {
                                <img src="@pizza.ImageUrl" class="card-img-top" style="height:150px; object-fit:cover;" />
                            }
                            <div class="card-body">
                                <h5 class="card-title">@pizza.Name</h5>
                                <p class="card-text">@pizza.Description</p>
                                <p class="card-text"><strong>@pizza.Price ₽</strong> (@pizza.Size)</p>
                                @if (pizza.Vegetarian)
                                {
                                    <span class="badge bg-success">Вегетарианская</span>
                                }
                            </div>
                            <div class="card-footer">
                                <div class="d-flex justify-content-between align-items-center">
                                    <button class="btn btn-sm btn-secondary" @onclick="() => DecrementLocalQuantity(pizza.Id)">-</button>
                                    <span>@GetLocalQuantity(pizza.Id)</span>
                                    <button class="btn btn-sm btn-primary" @onclick="() => IncrementLocalQuantity(pizza.Id)">+</button>
                                    <button class="btn btn-sm btn-success" @onclick="() => AddToCart(pizza, GetLocalQuantity(pizza.Id))">В корзину</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<Pizza> pizzas = new();
    private string _searchTerm = "";
    private bool _onlyVegetarian = false;
    private Dictionary<int, int> localQuantities = new();

    private List<Pizza> GetFilteredPizzas()
    {
        if (pizzas == null) return new List<Pizza>();
        var query = pizzas.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
            query = query.Where(p => p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                     p.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        if (_onlyVegetarian)
            query = query.Where(p => p.Vegetarian);
        return query.ToList();
    }

    private int GetLocalQuantity(int id) => localQuantities.GetValueOrDefault(id, 1);
    private void IncrementLocalQuantity(int id)
    {
        var current = GetLocalQuantity(id);
        if (current < 99) localQuantities[id] = current + 1;
    }
    private void DecrementLocalQuantity(int id)
    {
        var current = GetLocalQuantity(id);
        if (current > 1) localQuantities[id] = current - 1;
    }

    protected override async Task OnInitializedAsync()
    {
        pizzas = await PizzaRepo.GetAllAsync();
        foreach (var pizza in pizzas)
            localQuantities.TryAdd(pizza.Id, 1);
        StateHasChanged();
    }

    private void AddToCart(Pizza pizza, int quantity)
    {
        if (quantity <= 0) return;
        Cart.AddItem("Pizza", pizza.Id, pizza.Name, pizza.Price, quantity);
        Snackbar.Add($"{pizza.Name} добавлена в корзину (x{quantity})", Severity.Success);
        localQuantities[pizza.Id] = 1;
    }
}