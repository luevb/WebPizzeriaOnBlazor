@page "/menu/pizzas"
@using BlazorPizzeria.Models
@using BlazorPizzeria.Services
@inject IPizzaRepository PizzaRepo
@inject CartService Cart
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="my-8">
    <MudText Typo="Typo.h4">🍕 Пицца</MudText>

    <!-- Панель фильтров -->
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_searchTerm"
                          Label="Поиск по названию или описанию"
                          Variant="@Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSwitch T="bool"
                       Label="Только вегетарианские"
                       Color="Color.Success"
                       Checked="_onlyVegetarian"
                       CheckedChanged="@((bool val) => { _onlyVegetarian = val; StateHasChanged(); })" />
        </MudItem>
    </MudGrid>

    @if (filteredPizzas == null)
    {
        <MudProgressCircular Indeterminate />
    }
    else if (!filteredPizzas.Any())
    {
        <MudAlert Severity="Severity.Info">Пиццы не найдены. Попробуйте изменить фильтры.</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var pizza in filteredPizzas)
            {
                var localQty = GetLocalQuantity(pizza.Id);
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="2" Class="d-flex flex-column" Style="height: 100%">
                        @if (!string.IsNullOrEmpty(pizza.ImageUrl))
                        {
                            <MudCardMedia Image="@pizza.ImageUrl" Height="150" />
                        }
                        <MudCardContent>
                            <MudText Typo="Typo.h6">@pizza.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">@pizza.Description</MudText>
                            <MudText Typo="Typo.subtitle1" Class="mt-2">
                                @pizza.Price ₽ (@pizza.Size)
                                @if (pizza.IsVegetarian)
                                {
                                    <MudBadge Color="Color.Success" Class="ms-2">Вегетарианская</MudBadge>
                                }
                            </MudText>
                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                               Size="Size.Small"
                                               Color="Color.Secondary"
                                               OnClick="() => DecrementLocalQuantity(pizza.Id)" />
                                <MudText Typo="Typo.body1" Class="mx-2" Style="min-width: 30px; text-align: center;">
                                    @localQty
                                </MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="() => IncrementLocalQuantity(pizza.Id)" />
                            </div>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="@Variant.Filled" Color="@Color.Primary"
                                       FullWidth="true"
                                       OnClick="() => AddToCart(pizza, localQty)">
                                В корзину
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<Pizza> pizzas = new();
    private string _searchTerm = "";
    private bool _onlyVegetarian = false;
    private Dictionary<int, int> localQuantities = new();

    private List<Pizza> filteredPizzas => pizzas?
        .Where(p => string.IsNullOrWhiteSpace(_searchTerm) ||
                    p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    p.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(p => !_onlyVegetarian || p.IsVegetarian)
        .ToList() ?? new List<Pizza>();

    private int GetLocalQuantity(int id) => localQuantities.GetValueOrDefault(id, 1);

    private void IncrementLocalQuantity(int id)
    {
        var current = GetLocalQuantity(id);
        if (current < 99) localQuantities[id] = current + 1;
    }

    private void DecrementLocalQuantity(int id)
    {
        var current = GetLocalQuantity(id);
        if (current > 1) localQuantities[id] = current - 1;
    }

    protected override async Task OnInitializedAsync()
    {
        pizzas = await PizzaRepo.GetAllAsync();
        // Инициализируем локальные количества единицами
        foreach (var pizza in pizzas)
            localQuantities.TryAdd(pizza.Id, 1);
        StateHasChanged();
    }

    private void AddToCart(Pizza pizza, int quantity)
    {
        if (quantity <= 0) return;
        Cart.AddItem("Pizza", pizza.Id, pizza.Name, pizza.Price, quantity);
        Snackbar.Add($"{pizza.Name} добавлена в корзину (x{quantity})", Severity.Success);
        // После добавления сбрасываем локальное количество в 1 (опционально)
        localQuantities[pizza.Id] = 1;
    }
}