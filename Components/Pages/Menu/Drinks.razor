@page "/menu/drink"
@using BlazorPizzeria.Models
@using BlazorPizzeria.Services
@inject IDrinkRepository DrinkRepo
@inject CartService Cart
@inject ISnackbar Snackbar

<h3>🥤 Напитки</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <input type="text" class="form-control" placeholder="Поиск по названию или описанию" @bind="_searchTerm" @bind:event="oninput" />
    </div>
</div>

@if (drinks == null)
{
    <p>Загрузка...</p>
}
else if (!drinks.Any())
{
    <div class="alert alert-info">Напитки не найдены.</div>
}
else
{
    var displayed = string.IsNullOrWhiteSpace(_searchTerm) ? drinks : drinks.Where(d => d.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) || d.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
    <div class="row">
        @foreach (var drink in displayed)
        {
            var localQty = GetLocalQuantity(drink.Id);
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(drink.ImageUrl))
                    {
                        <img src="@drink.ImageUrl" class="card-img-top" alt="@drink.Name" style="height: 150px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@drink.Name</h5>
                        <p class="card-text">@drink.Description</p>
                        <p class="card-text"><strong>@drink.Price ₽</strong></p>
                        <div class="d-flex align-items-center justify-content-between mt-3">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => DecrementLocalQuantity(drink.Id)">–</button>
                            <span class="mx-2">@localQty</span>
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => IncrementLocalQuantity(drink.Id)">+</button>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-primary w-100" @onclick="() => AddToCart(drink, localQty)">В корзину</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Drink> drinks = new();
    private string _searchTerm = "";
    private Dictionary<int, int> localQuantities = new();

    private int GetLocalQuantity(int id) => localQuantities.GetValueOrDefault(id, 1);
    private void IncrementLocalQuantity(int id) => localQuantities[id] = Math.Min(GetLocalQuantity(id) + 1, 99);
    private void DecrementLocalQuantity(int id)
    {
        var current = GetLocalQuantity(id);
        if (current > 1) localQuantities[id] = current - 1;
    }

    protected override async Task OnInitializedAsync()
    {
        drinks = await DrinkRepo.GetAllAsync();
        foreach (var drink in drinks) localQuantities.TryAdd(drink.Id, 1);
        StateHasChanged();
    }

    private void AddToCart(Drink drink, int quantity)
    {
        if (quantity <= 0) return;
        Cart.AddItem("Drink", drink.Id, drink.Name, drink.Price, quantity);
        Snackbar.Add($"{drink.Name} добавлен в корзину (x{quantity})", Severity.Success);
        localQuantities[drink.Id] = 1;
    }
}