@page "/checkout"
@using BlazorPizzeria.Models
@using BlazorPizzeria.Services
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CartService Cart
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="my-8">
    <MudText Typo="Typo.h4" Class="mb-4">📝 Оформление заказа</MudText>

    @if (Cart.Items.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            Корзина пуста. <MudLink Href="/menu/pizzas" Underline="Underline.Always">Перейти к меню</MudLink>
        </MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="7">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Контактные данные</MudText>

                        <MudTextField @bind-Value="_customerName"
                                      Label="Ваше имя"
                                      Variant="@Variant.Outlined"
                                      Required="true"
                                      For="@(() => _customerName)" />

                        <MudTextField @bind-Value="_phone"
                                      Label="Телефон"
                                      Variant="@Variant.Outlined"
                                      Required="true"
                                      HelperText="Только цифры и знаки +()- , например +7 (123) 456-78-90"
                                      For="@(() => _phone)" />

                        <MudAutocomplete T="string"
                                         Label="Адрес доставки"
                                         @bind-Value="_address"
                                         SearchFunc="@SearchAddress"
                                         Variant="@Variant.Outlined"
                                         Required="true"
                                         HelperText="Введите улицу и номер дома" />

                        <MudButton Variant="@Variant.Filled"
                                   Color="@Color.Primary"
                                   FullWidth="true"
                                   Class="mt-4"
                                   OnClick="SubmitOrder">
                            Подтвердить заказ
                        </MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Ваш заказ</MudText>
                        <MudTable Items="@Cart.Items" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Товар</MudTh>
                                <MudTh>Кол-во</MudTh>
                                <MudTh>Сумма</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Name</MudTd>
                                <MudTd>@context.Quantity</MudTd>
                                <MudTd>@(context.Price* context.Quantity) ₽</MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTr>
                                    <MudTd colspan="2"><strong>Итого:</strong></MudTd>
                                    <MudTd><strong>@Cart.TotalPrice ₽</strong></MudTd>
                                </MudTr>
                            </FooterContent>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private string _customerName = "";
    private string _phone = "";
    private string _address = "";

    // Локальный список подсказок для адреса (можно расширить)
    private readonly List<string> _addressSuggestions = new()
    {
        "г Москва, ул Тверская, д 1",
        "г Москва, ул Арбат, д 10",
        "г Москва, Ленинский пр-т, д 30",
        "г Москва, ул 11-я Парковая, д 36",
        "г Москва, ул Пушкина, д 5"
    };

    private async Task<IEnumerable<string>> SearchAddress(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
            return new List<string>();
        // Поиск похожих адресов
        return _addressSuggestions.Where(a => a.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    protected override void OnInitialized()
    {
        Cart.OnChange += StateHasChanged;
    }
    private bool IsValidPhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return false;
        // Удаляем все символы, кроме цифр
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        // Допустимая длина номера (10-15 цифр, для России 11)
        return digits.Length >= 10 && digits.Length <= 15;
    }

    private bool IsValidAddress(string address)
    {
        if (string.IsNullOrWhiteSpace(address)) return false;
        // Адрес должен содержать хотя бы одну цифру (номер дома) и букву (название улицы)
        return address.Any(char.IsDigit) && address.Any(char.IsLetter);
    }

    private async Task SubmitOrder()
    {
        // Простая ручная валидация
        if (string.IsNullOrWhiteSpace(_customerName))
        {
            Snackbar.Add("Введите ваше имя", Severity.Warning);
            return;
        }
        if (!IsValidPhone(_phone))
        {
            Snackbar.Add("Введите корректный номер телефона (10-15 цифр)", Severity.Warning);
            return;
        }
        if (!IsValidAddress(_address))
        {
            Snackbar.Add("Укажите полный адрес (улица, дом)", Severity.Warning);
            return;
        }
        if (!IsValidAddress(_address))
        {
            Snackbar.Add("Укажите полный адрес (улица, дом)", Severity.Warning);
            return;
        }

        if (!IsMoscowAddress(_address))
        {
            Snackbar.Add("Доставка осуществляется только по Москве", Severity.Warning);
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var order = new Order
            {
                CustomerName = _customerName,
                Phone = _phone,
                Address = _address,
                OrderDate = DateTime.Now,
                TotalPrice = Cart.TotalPrice,
                Status = "Pending"
            };

            foreach (var item in Cart.Items)
            {
                var orderItem = new OrderItem
                {
                    Quantity = item.Quantity,
                    UnitPrice = item.Price
                };
                switch (item.ProductType)
                {
                    case "Pizza":
                        orderItem.PizzaId = item.ProductId;
                        break;
                    case "Drink":
                        orderItem.DrinkId = item.ProductId;
                        break;
                    case "Dessert":
                        orderItem.DessertId = item.ProductId;
                        break;
                }
                order.OrderItems.Add(orderItem);
            }

            db.Orders.Add(order);
            await db.SaveChangesAsync();

            Cart.Clear();
            Snackbar.Add("Заказ оформлен! Перенаправление на оплату...", Severity.Success);
            Navigation.NavigateTo($"/payment/{order.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при оформлении: {ex.Message}", Severity.Error);
        }
    }

    private bool IsMoscowAddress(string address)
    {
        if (string.IsNullOrWhiteSpace(address)) return false;
        var lower = address.ToLower();
        return lower.Contains("москва") || lower.Contains("moscow");
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
    }
}