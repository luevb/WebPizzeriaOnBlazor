@page "/checkout"
@using BlazorPizzeria.Models
@using BlazorPizzeria.Services
@inject DadataService Dadata
@using MudBlazor
@using BlazorPizzeria.Validators
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.EntityFrameworkCore
@using System.Text.RegularExpressions
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CartService Cart
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ProtectedSessionStorage SessionStorage

<h3>Оформление заказа</h3>

@if (Cart.Items.Count == 0)
{
    <div class="alert alert-warning">
        Корзина пуста. <a href="/menu/pizzas">Перейти к меню</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Контактные данные</h5>

                    <div class="mb-3">
                        <label class="form-label">Ваше имя</label>
                        <input @bind="customerName" class="form-control" pattern="[A-Za-zА-Яа-яЁё\s\-']+" title="Только буквы, пробелы, дефис и апостроф" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Телефон</label>
                        <input @bind="phone" class="form-control" pattern="\+7[0-9]{10}" title="Введите +7 и 10 цифр" inputmode="numeric" placeholder="+79001234567" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Способ получения</label>
                        <select @bind="deliveryType" class="form-select">
                            <option value="Delivery">Доставка по Москве</option>
                            <option value="Pickup">Самовывоз (бесплатно)</option>
                        </select>
                    </div>

                    @if (deliveryType == "Delivery")
                    {
                        <div class="mb-3">
                            <label class="form-label">Адрес доставки</label>
                            <MudAutocomplete T="string"
                                             @bind-Value="address"
                                             SearchFunc="@SearchAddress"
                                             Variant="@Variant.Outlined"
                                             Placeholder="Начните вводить улицу и дом"
                                             HelperText="Например, Москва, ул. Тверская, д. 1"
                                             FullWidth="true"
                                             DebounceInterval="300"
                                             MinCharacters="3" />
                            <small class="text-muted">Выберите адрес из подсказок</small>
                        </div>
                    }

                    <button class="btn btn-primary w-100" @onclick="SubmitOrder">Подтвердить заказ</button>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Ваш заказ</h5>
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Товар</th><th>Кол-во</th><th>Сумма</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Cart.Items)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>@(item.Price * item.Quantity) ₽</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th colspan="2">Итого:</th><th>@Cart.TotalPrice ₽</th></tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string customerName = "";
    private string phone = "";
    private string deliveryType = "Delivery";
    private string address = "";

    private async Task<IEnumerable<string>> SearchAddress(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return new List<string>();
        return await Dadata.SuggestAddressAsync(value);
    }

    private async Task SubmitOrder()
    {
        // 1. Проверка имени
        if (string.IsNullOrWhiteSpace(customerName))
        {
            Snackbar.Add("Введите ваше имя", Severity.Warning);
            return;
        }
        var nameRegex = new Regex(@"^[a-zA-Zа-яА-ЯёЁ\s\-']+$");
        if (!nameRegex.IsMatch(customerName))
        {
            Snackbar.Add("Имя может содержать только буквы, пробелы, дефис и апостроф", Severity.Warning);
            return;
        }

        // 2. Проверка телефона
        var phoneRegex = new Regex(@"^\+7\d{10}$");
        if (!phoneRegex.IsMatch(phone))
        {
            Snackbar.Add("Номер телефона должен быть в формате +7XXXXXXXXXX (10 цифр)", Severity.Warning);
            return;
        }

        // 3. Проверка адреса при доставке (включая Москву)
        if (deliveryType == "Delivery")
        {
            if (string.IsNullOrWhiteSpace(address))
            {
                Snackbar.Add("Укажите адрес доставки", Severity.Warning);
                return;
            }
            if (!address.ToLower().Contains("москва") && !address.ToLower().Contains("moscow"))
            {
                Snackbar.Add("Доставка осуществляется только по Москве", Severity.Warning);
                return;
            }
        }
        else
        {
            address = "г. Москва, ул. Тверская, д. 1";
        }

        // 4. FluentValidation (дополнительная проверка)
        var validator = new OrderValidator();
        var orderToValidate = new Order
        {
            CustomerName = customerName,
            Phone = phone,
            Address = deliveryType == "Delivery" ? address : "Самовывоз",
            DeliveryType = deliveryType
        };
        var validationResult = await validator.ValidateAsync(orderToValidate);
        if (!validationResult.IsValid)
        {
            foreach (var error in validationResult.Errors)
                Snackbar.Add(error.ErrorMessage, Severity.Warning);
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var order = new Order
            {
                CustomerName = customerName,
                Phone = phone,
                Address = deliveryType == "Delivery" ? address : "г. Москва, ул. Тверская, д. 1",
                DeliveryType = deliveryType,
                OrderDate = DateTime.Now,
                TotalPrice = Cart.TotalPrice,
                Status = "Pending",
                OrderItems = new List<OrderItem>()
            };

            foreach (var item in Cart.Items)
            {
                var orderItem = new OrderItem
                {
                    Quantity = item.Quantity,
                    UnitPrice = item.Price
                };
                switch (item.ProductType)
                {
                    case "Pizza":
                        orderItem.PizzaId = item.ProductId;
                        break;
                    case "Drink":
                        orderItem.DrinkId = item.ProductId;
                        break;
                    case "Dessert":
                        orderItem.DessertId = item.ProductId;
                        break;
                }
                order.OrderItems.Add(orderItem);
            }

            db.Orders.Add(order);
            await db.SaveChangesAsync();

            await SessionStorage.SetAsync("userPhone", order.Phone);
            Cart.Clear();
            Snackbar.Add("Заказ оформлен! Перенаправление на оплату...", Severity.Success);
            Navigation.NavigateTo($"/payment/{order.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }
}