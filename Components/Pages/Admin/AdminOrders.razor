@page "/admin/orders"
@attribute [StreamRendering(false)]
@using BlazorPizzeria.Models
@using BlazorPizzeria.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using OfficeOpenXml
@inject IOrderRepository OrderRepo
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation

<h3>Управление заказами</h3>

<div class="mb-3">
    <button class="btn btn-danger float-end" @onclick="Logout">Выйти</button>
    <button class="btn btn-success" @onclick="ExportToExcel">Экспорт в Excel</button>
</div>

@if (!_isAuthorized)
{
    <div class="alert alert-info">Проверка доступа...</div>
}
else if (orders == null)
{
    <p>Загрузка...</p>
}
else
{
    <!-- Фильтры -->
    <div class="row mb-3">
        <div class="col-md-3">
            <label>Статус</label>
            <select @bind="statusFilter" class="form-select">
                <option value="All">Все</option>
                <option value="Pending">Ожидает</option>
                <option value="InProgress">Готовится</option>
                <option value="Delivered">Доставляется</option>
                <option value="Completed">Выполнен</option>
                <option value="Cancelled">Отменён</option>
            </select>
        </div>
        <div class="col-md-2">
            <label>С даты</label>
            <input type="date" @bind="fromDate" class="form-control" />
        </div>
        <div class="col-md-2">
            <label>По дату</label>
            <input type="date" @bind="toDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Поиск (телефон / ID)</label>
            <input @bind="searchTerm" class="form-control" placeholder="Введите номер телефона или ID" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary me-2" @onclick="LoadFilteredOrders">Применить</button>
            <button class="btn btn-secondary" @onclick="ResetFilters">Сбросить</button>
        </div>
    </div>

    <!-- Статистика -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Заказов сегодня</h5>
                    <p class="card-text display-6">@stats.TodayCount</p>
                    <small>Сумма: @stats.TodaySum ₽</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h5 class="card-title">Заказов вчера</h5>
                    <p class="card-text display-6">@stats.YesterdayCount</p>
                    <small>Сумма: @stats.YesterdaySum ₽</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Всего заказов</h5>
                    <p class="card-text display-6">@stats.TotalCount</p>
                    <small>Сумма: @stats.TotalSum ₽</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Средний чек</h5>
                    <p class="card-text display-6">@stats.AverageCheck ₽</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Статистика по дням -->
    <div class="card mb-4">
        <div class="card-header">Заказы по дням (последние 7 дней)</div>
        <div class="card-body">
            <table class="table table-sm">
                <thead>
                    <tr><th>Дата</th><th>Количество заказов</th><th>Выручка</th></tr>
                </thead>
                <tbody>
                    @foreach (var day in dailyStats)
                    {
                        <tr>
                            <td>@day.Date.ToShortDateString()</td>
                            <td>@day.Count</td
                            <td>@day.Total ₽</td
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Таблица заказов -->
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr><th>ID</th><th>Клиент</th><th>Телефон</th><th>Адрес</th><th>Дата</th><th>Сумма</th><th>Статус</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var order in orders)
                {
                    <tr>
                        <td>@order.Id</td
                        <td>@order.CustomerName</td
                        <td>@order.Phone</td
                        <td>@order.Address</td
                        <td>@order.OrderDate.ToShortDateString()</td
                        <td>@order.TotalPrice ₽</td
                        <td>
                            <select class="form-select form-select-sm" @bind="order.Status" @bind:after="() => UpdateStatus(order)">
                                <option value="Pending">Ожидает</option>
                                <option value="InProgress">Готовится</option>
                                <option value="Delivered">Доставляется</option>
                                <option value="Completed">Выполнен</option>
                                <option value="Cancelled">Отменён</option>
                            </select>
                         </td
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => ShowDetails(order)">Детали</button>
                         </td
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Детали заказа -->
@if (selectedOrder != null)
{
    <div class="card mt-4">
        <div class="card-header">
            <strong>Детали заказа #@selectedOrder.Id</strong>
            <button class="btn-close float-end" @onclick="() => selectedOrder = null"></button>
        </div>
        <div class="card-body">
            <p><strong>Клиент:</strong> @selectedOrder.CustomerName</p>
            <p><strong>Телефон:</strong> @selectedOrder.Phone</p>
            <p><strong>Адрес:</strong> @selectedOrder.Address</p>
            <p><strong>Дата:</strong> @selectedOrder.OrderDate</p>
            <p><strong>Статус:</strong> @selectedOrder.Status</p>
            <h6>Состав заказа:</h6>
            <table class="table table-sm">
                <thead><tr><th>Товар</th><th>Кол-во</th><th>Цена</th><th>Сумма</th></tr></thead>
                <tbody>
                    @foreach (var item in selectedOrder.OrderItems)
                    {
                        <tr>
                            <td>@GetProductName(item)</td
                            <td>@item.Quantity</td
                            <td>@item.UnitPrice ₽</td
                            <td>@(item.Quantity * item.UnitPrice) ₽</td
                        </tr>
                    }
                </tbody>
                <tfoot><tr><th colspan="3">Итого</th><th>@selectedOrder.TotalPrice ₽</th></tr></tfoot>
            </table>
        </div>
    </div>
}

@code {
    private List<Order> orders = new();
    private Order? selectedOrder;
    private string statusFilter = "All";
    private DateTime? fromDate;
    private DateTime? toDate;
    private string searchTerm = "";

    private StatsData stats = new();
    private List<DailyStat> dailyStats = new();

    private bool _isAuthorized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var result = await SessionStorage.GetAsync<bool>("IsAdmin");
            if (!result.Success || !result.Value)
            {
                Snackbar.Add("Доступ запрещён. Войдите как администратор.", MudBlazor.Severity.Warning);
                Navigation.NavigateTo("/admin/login");
                return;
            }
            _isAuthorized = true;
            await LoadFilteredOrders();
            StateHasChanged();
        }
    }

    private async Task LoadFilteredOrders()
    {
        orders = await OrderRepo.GetFilteredOrdersAsync(
            statusFilter == "All" ? null : statusFilter,
            fromDate,
            toDate,
            string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm);
        await LoadStats();
        await LoadDailyStats();
        StateHasChanged();
    }

    private async Task LoadStats()
    {
        var allOrders = await OrderRepo.GetAllAsync();
        var today = DateTime.Today;
        var yesterday = today.AddDays(-1);
        var todayOrders = allOrders.Where(o => o.OrderDate.Date == today).ToList();
        var yesterdayOrders = allOrders.Where(o => o.OrderDate.Date == yesterday).ToList();

        stats.TodayCount = todayOrders.Count;
        stats.TodaySum = todayOrders.Sum(o => o.TotalPrice);
        stats.YesterdayCount = yesterdayOrders.Count;
        stats.YesterdaySum = yesterdayOrders.Sum(o => o.TotalPrice);
        stats.TotalCount = allOrders.Count;
        stats.TotalSum = allOrders.Sum(o => o.TotalPrice);
        stats.AverageCheck = stats.TotalCount > 0 ? (stats.TotalSum / stats.TotalCount) : 0;
    }

    private async Task LoadDailyStats()
    {
        var allOrders = await OrderRepo.GetAllAsync();
        var last7Days = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(-i)).Reverse().ToList();
        dailyStats = last7Days.Select(date => new DailyStat
        {
            Date = date,
            Count = allOrders.Count(o => o.OrderDate.Date == date),
            Total = allOrders.Where(o => o.OrderDate.Date == date).Sum(o => o.TotalPrice)
        }).ToList();
    }

    private async Task ResetFilters()
    {
        statusFilter = "All";
        fromDate = null;
        toDate = null;
        searchTerm = "";
        await LoadFilteredOrders();
    }

    private async Task UpdateStatus(Order order)
    {
        await OrderRepo.UpdateStatusAsync(order.Id, order.Status);
        Snackbar.Add($"Статус заказа #{order.Id} изменён на {order.Status}", MudBlazor.Severity.Info);
        await LoadFilteredOrders();
    }

    private void ShowDetails(Order order) => selectedOrder = order;

    private string GetProductName(OrderItem item)
    {
        if (item.Pizza != null) return item.Pizza.Name;
        if (item.Drink != null) return item.Drink.Name;
        if (item.Dessert != null) return item.Dessert.Name;
        return "Товар";
    }

    private async Task ExportToExcel()
    {
        using var package = new ExcelPackage();
        var worksheet = package.Workbook.Worksheets.Add("Заказы");
        worksheet.Cells[1, 1].Value = "ID";
        worksheet.Cells[1, 2].Value = "Клиент";
        worksheet.Cells[1, 3].Value = "Телефон";
        worksheet.Cells[1, 4].Value = "Адрес";
        worksheet.Cells[1, 5].Value = "Дата";
        worksheet.Cells[1, 6].Value = "Сумма";
        worksheet.Cells[1, 7].Value = "Статус";

        for (int i = 0; i < orders.Count; i++)
        {
            var order = orders[i];
            worksheet.Cells[i + 2, 1].Value = order.Id;
            worksheet.Cells[i + 2, 2].Value = order.CustomerName;
            worksheet.Cells[i + 2, 3].Value = order.Phone;
            worksheet.Cells[i + 2, 4].Value = order.Address;
            worksheet.Cells[i + 2, 5].Value = order.OrderDate.ToString("yyyy-MM-dd HH:mm");
            worksheet.Cells[i + 2, 6].Value = order.TotalPrice;
            worksheet.Cells[i + 2, 7].Value = order.Status;
        }

        worksheet.Cells.AutoFitColumns();
        var stream = new MemoryStream();
        package.SaveAs(stream);
        stream.Position = 0;
        var base64 = Convert.ToBase64String(stream.ToArray());
        await JS.InvokeVoidAsync("saveAsFile", $"Orders_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", base64);
    }

    private async Task Logout()
    {
        await SessionStorage.DeleteAsync("IsAdmin");
        Snackbar.Add("Вы вышли из админ-панели", MudBlazor.Severity.Info);
        Navigation.NavigateTo("/");
    }

    private class StatsData
    {
        public int TodayCount { get; set; }
        public decimal TodaySum { get; set; }
        public int YesterdayCount { get; set; }
        public decimal YesterdaySum { get; set; }
        public int TotalCount { get; set; }
        public decimal TotalSum { get; set; }
        public decimal AverageCheck { get; set; }
    }

    private class DailyStat
    {
        public DateTime Date { get; set; }
        public int Count { get; set; }
        public decimal Total { get; set; }
    }
}